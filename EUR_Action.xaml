  <Sequence DisplayName="EUR_Action - detect EUR in the advice and return the EUR amount">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="patterns" />
      <Variable x:TypeArguments="x:String" Name="markerRx" />
      <Variable x:TypeArguments="x:String" Name="amountRx" />
    </Sequence.Variables>
    <Assign DisplayName="Default: not EUR"><Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_IsEur]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Boolean">[False]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Default amount"><Assign.To><OutArgument x:TypeArguments="x:String">[out_EurAmount]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[""]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Default message"><Assign.To><OutArgument x:TypeArguments="x:String">[out_Message]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[""]</InArgument></Assign.Value></Assign>
    <ui:ReadRange Range="{x:Null}" WorkbookPathResource="{x:Null}" AddHeaders="True" DataTable="[patterns]" DisplayName="Read the per-bank EUR advice format table" SheetName="EUR_Patterns" WorkbookPath="Excel\Cash_Management_Entry.xlsx" />
    <Assign DisplayName="Bank marker regex"><Assign.To><OutArgument x:TypeArguments="x:String">[markerRx]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(patterns.AsEnumerable().Where(Function(r) r("Bank").ToString.Trim.ToUpper = in_BankName.Trim.ToUpper).Select(Function(r) r("Marker_Regex").ToString).FirstOrDefault() Is Nothing, "", patterns.AsEnumerable().Where(Function(r) r("Bank").ToString.Trim.ToUpper = in_BankName.Trim.ToUpper).Select(Function(r) r("Marker_Regex").ToString).FirstOrDefault().Trim)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Bank amount regex"><Assign.To><OutArgument x:TypeArguments="x:String">[amountRx]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(patterns.AsEnumerable().Where(Function(r) r("Bank").ToString.Trim.ToUpper = in_BankName.Trim.ToUpper).Select(Function(r) r("Amount_Regex").ToString).FirstOrDefault() Is Nothing, "", patterns.AsEnumerable().Where(Function(r) r("Bank").ToString.Trim.ToUpper = in_BankName.Trim.ToUpper).Select(Function(r) r("Amount_Regex").ToString).FirstOrDefault().Trim)]</InArgument></Assign.Value></Assign>
    <If Condition="[markerRx = &quot;&quot; Or amountRx = &quot;&quot;]" DisplayName="Format known for this bank?">
      <If.Then>
        <Assign DisplayName="Format not provided yet"><Assign.To><OutArgument x:TypeArguments="x:String">[out_Message]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">["EUR advice format not defined for bank " + in_BankName + " - add Marker_Regex and Amount_Regex in sheet EUR_Patterns"]</InArgument></Assign.Value></Assign>
      </If.Then>
      <If.Else>
        <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For each advice PDF" Values="[in_PdfPaths]">
          <ui:ForEach.Body>
            <ActivityAction x:TypeArguments="x:String">
              <ActivityAction.Argument>
                <DelegateInArgument x:TypeArguments="x:String" Name="pdfPath" />
              </ActivityAction.Argument>
              <Sequence DisplayName="Check one PDF">
                <Sequence.Variables>
                  <Variable x:TypeArguments="x:String" Name="pdfText" />
                  <Variable x:TypeArguments="x:String" Name="flatText" />
                  <Variable x:TypeArguments="x:String" Name="amt" />
                </Sequence.Variables>
                <TryCatch DisplayName="Read the PDF (skip unreadable)">
                  <TryCatch.Try>
                    <Sequence DisplayName="Read">
                      <ui:ReadPDFText PreserveFormatting="{x:Null}" DisplayName="Read PDF Text" FileName="[pdfPath]" Password="[in_Password]" Range="All" Text="[pdfText]" />
                      <Assign DisplayName="Collapse whitespace"><Assign.To><OutArgument x:TypeArguments="x:String">[flatText]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Replace(pdfText, "\s+", " ")]</InArgument></Assign.Value></Assign>
                    </Sequence>
                  </TryCatch.Try>
                  <TryCatch.Catches>
                    <Catch x:TypeArguments="s:Exception">
                      <ActivityAction x:TypeArguments="s:Exception">
                        <ActivityAction.Argument>
                          <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                        </ActivityAction.Argument>
                        <Assign DisplayName="Unreadable PDF"><Assign.To><OutArgument x:TypeArguments="x:String">[flatText]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[""]</InArgument></Assign.Value></Assign>
                      </ActivityAction>
                    </Catch>
                  </TryCatch.Catches>
                </TryCatch>
                <If Condition="[Not out_IsEur AndAlso flatText &lt;&gt; &quot;&quot; AndAlso System.Text.RegularExpressions.Regex.IsMatch(flatText, markerRx, System.Text.RegularExpressions.RegexOptions.IgnoreCase)]" DisplayName="EUR marker found in this PDF?">
                  <If.Then>
                    <Sequence DisplayName="EUR">
                      <Assign DisplayName="Is EUR"><Assign.To><OutArgument x:TypeArguments="x:Boolean">[out_IsEur]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Boolean">[True]</InArgument></Assign.Value></Assign>
                      <Assign DisplayName="EUR amount"><Assign.To><OutArgument x:TypeArguments="x:String">[amt]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Match(flatText, amountRx, System.Text.RegularExpressions.RegexOptions.IgnoreCase).Groups(1).Value.Replace(",", "").Trim]</InArgument></Assign.Value></Assign>
                      <Assign DisplayName="Return amount"><Assign.To><OutArgument x:TypeArguments="x:String">[out_EurAmount]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[amt]</InArgument></Assign.Value></Assign>
                      <Assign DisplayName="Message"><Assign.To><OutArgument x:TypeArguments="x:String">[out_Message]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(amt = "", "EUR advice found but the EUR amount could not be read (check Amount_Regex for " + in_BankName + ")", "EUR advice, amount " + amt)]</InArgument></Assign.Value></Assign>
                    </Sequence>
                  </If.Then>
                </If>
              </Sequence>
            </ActivityAction>
          </ui:ForEach.Body>
        </ui:ForEach>
      </If.Else>
    </If>
  </Sequence>
</Activity>
