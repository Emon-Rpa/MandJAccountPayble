e.Trim&#xA;contractRef = System.Text.RegularExpressions.Regex.Match(pdfText, &quot;\b225[A-Z]{2,6}\d{6,}\b&quot;).Value&#xA;beneficiary = &quot;&quot;&#xA;If ourRef &lt;&gt; &quot;&quot; Then&#xA;    beneficiary = System.Text.RegularExpressions.Regex.Match(pdfText, System.Text.RegularExpressions.Regex.Escape(ourRef) &amp; &quot;[ \t\r]*\n[ \t]*([^\r\n]+)&quot;).Groups(1).Value.Trim&#xA;    If System.Text.RegularExpressions.Regex.IsMatch(beneficiary, &quot;^[0-9]+$&quot;) OrElse beneficiary = &quot;N/A&quot; Then beneficiary = &quot;&quot;&#xA;End If" DisplayName="Parse advice (pick the debit line equal to the statement amount)"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="pdfText">[pdfText]</InArgument><InArgument x:TypeArguments="x:String" x:Key="rowAmount">[rowAmount]</InArgument><InArgument x:TypeArguments="x:String" x:Key="ourRef">[ourRef]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="advType">[advType]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="pdfCcy">[pdfCcy]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="pdfAmt">[pdfAmt]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="pdfAcct">[pdfAcct]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="advTitle">[advTitle]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="contractRef">[contractRef]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="beneficiary">[beneficiary]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="advLines">[advLines]</OutArgument><OutArgument x:TypeArguments="x:Boolean" x:Key="amountMatched">[amountMatched]</OutArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If Condition="[pdfCcy &lt;&gt; &quot;&quot; AndAlso in_Row(&quot;CURRENCY&quot;).ToString.Trim = &quot;&quot;]" DisplayName="Fill currency if blank"><If.Then><Assign DisplayName="CURRENCY"><Assign.To><OutArgument x:TypeArguments="x:Object">[in_Row("CURRENCY")]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[pdfCcy]</InArgument></Assign.Value></Assign></If.Then></If><If Condition="[pdfAcct &lt;&gt; &quot;&quot; AndAlso in_Row(&quot;TO_ACCOUNT&quot;).ToString.Trim = &quot;&quot;]" DisplayName="Fill account if blank"><If.Then><Assign DisplayName="TO_ACCOUNT"><Assign.To><OutArgument x:TypeArguments="x:Object">[in_Row("TO_ACCOUNT")]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[pdfAcct]</InArgument></Assign.Value></Assign></If.Then></If><If Condition="[beneficiary &lt;&gt; &quot;&quot;]" DisplayName="Fill beneficiary"><If.Then><Assign DisplayName="TRADING_PARTNER"><Assign.To><OutArgument x:TypeArguments="x:Object">[in_Row("TRADING_PARTNER")]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[beneficiary]</InArgument></Assign.Value></Assign></If.Then></If><Assign DisplayName="Report text"><Assign.To><OutArgument x:TypeArguments="x:String">[out_Report]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(pdfAmt = "", "Advice downloaded but no debit line was found in the PDF - check layout", If(amountMatched, "Advice read - Dhaka Bank " + advTitle + " " + contractRef + ": " + advType + " " + pdfCcy + " " + pdfAmt + " A/C " + pdfAcct + If(beneficiary = "", "", " | " + beneficiary), "Advice found (" + advTitle + " " + contractRef + ") but no debit line equals the statement amount " + rowAmount + ". Lines: " + advLines))]</InArgument></Assign.Value></Assign><ui:LogMessage DisplayName="Log result" Level="Info" Message="[&quot;Dhaka Bank advice: &quot; &amp; out_Report]" /></Sequence></If.Then><If.Else><Sequence DisplayName="No advice"><Assign DisplayName="Not found"><Assign.To><OutArgument x:TypeArguments="x:String">[out_Report]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">["Advice Not Found!"]</InArgument></Assign.Value></Assign></Sequence></If.Else></If></Sequence>
