            <TryCatch DisplayName="Try Catch" sap2010:WorkflowViewState.IdRef="TryCatch_1">
              <TryCatch.Try>
                <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Oracle_Apply_4c_LC_Receipt - Invoke Workflow File" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Oracle\Apply\Oracle_Apply_4c_LC_Receipt.xaml"><ui:InvokeWorkflowFile.Arguments><InArgument x:TypeArguments="x:String" x:Key="Unit">[unitItem]</InArgument><InArgument x:TypeArguments="x:String" x:Key="LC_Number">[testRow("LC_Number").ToString.Trim]</InArgument><InArgument x:TypeArguments="x:String" x:Key="Company">[testRow("Company").ToString.Trim]</InArgument><InArgument x:TypeArguments="x:Boolean" x:Key="Open_Unit_Form">[First_In_Unit]</InArgument><OutArgument x:TypeArguments="x:String" x:Key="Receipt_Number">[Receipt_Number]</OutArgument><OutArgument x:TypeArguments="x:String" x:Key="Status">[Status]</OutArgument></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile>
              </TryCatch.Try>
              <TryCatch.Catches><Catch x:TypeArguments="s:Exception"><ActivityAction x:TypeArguments="s:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="exception" /></ActivityAction.Argument><Sequence DisplayName="Catch"><Assign sap2010:WorkflowViewState.IdRef="Assign_7"><Assign.To><OutArgument x:TypeArguments="x:String">[Status]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">["Error: " + exception.Message]</InArgument></Assign.Value></Assign></Sequence></ActivityAction></Catch></TryCatch.Catches>
            </TryCatch>
            <ui:InvokeCode Language="VBNet" Code="row(&quot;Receipt_Number&quot;) = receipt&#xA;row(&quot;Status&quot;) = status&#xA;row(&quot;Checked_At&quot;) = DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)" DisplayName="Write result into row" sap2010:WorkflowViewState.IdRef="InvokeCode_1"><ui:InvokeCode.Arguments><InArgument x:TypeArguments="sd:DataRow" x:Key="row">[testRow]</InArgument><InArgument x:TypeArguments="x:String" x:Key="receipt">[Receipt_Number]</InArgument><InArgument x:TypeArguments="x:String" x:Key="status">[Status]</InArgument></ui:InvokeCode.Arguments></ui:InvokeCode>
