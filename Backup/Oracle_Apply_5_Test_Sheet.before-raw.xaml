    <ui:Comment Text="Unit test for the LC GRN lookup. Reads the test sheet (columns Unit, LC_Number, Company ...), opens each unit Invoice Workbench once, runs Oracle_Apply_4c_LC_Receipt per row and writes Receipt_Number, Status and Checked_At back into the same sheet after every row. The workbook must be closed in Excel while this runs." DisplayName="Comment" sap2010:WorkflowViewState.IdRef="Comment_1" />
    <ui:ReadRange Range="{x:Null}" AddHeaders="True" DataTable="[Test_Table]" DisplayName="Read test sheet" sap2010:WorkflowViewState.IdRef="ReadRange_1" SheetName="[If(String.IsNullOrWhiteSpace(Sheet_Name), &quot;Test&quot;, Sheet_Name)]" WorkbookPath="[Test_File]" />
    <Assign sap2010:WorkflowViewState.IdRef="Assign_2"><Assign.To><OutArgument x:TypeArguments="scg:List(x:String)">[Units]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="scg:List(x:String)">[Test_Table.AsEnumerable().Select(Function(r) r("Unit").ToString.Trim).Where(Function(u) u &lt;&gt; "").Distinct().ToList()]</InArgument></Assign.Value></Assign>
    <Assign sap2010:WorkflowViewState.IdRef="Assign_3"><Assign.To><OutArgument x:TypeArguments="x:Int32">[Done]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[0]</InArgument></Assign.Value></Assign>
