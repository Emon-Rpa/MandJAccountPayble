        <ForEach x:TypeArguments="sd:DataRow" DisplayName="For Each test row" sap2010:WorkflowViewState.IdRef="ForEach_2" Values="[Test_Table.AsEnumerable().Where(Function(r) r(&quot;Unit&quot;).ToString.Trim = unitItem).ToList()]">
          <ActivityAction x:TypeArguments="sd:DataRow"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="sd:DataRow" Name="testRow" /></ActivityAction.Argument>
          <If Condition="[Max_Rows &lt;= 0 OrElse Done &lt; Max_Rows]" sap2010:WorkflowViewState.IdRef="If_1"><If.Then>
          <Sequence DisplayName="Row">
