  <Sequence DisplayName="Oracle_Apply_4a_Read_Report" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:Comment Text="Reads the Oracle prepayment report (HTML saved as .xls) into a dictionary: unit (first word of OU Name, e.g. CAL, CGL, CWPL, GWN, GFL) to the list of Invoice Num values. Only rows whose Vendor Site Code is LC OPENING CHAR are kept; Lc_Info maps invoice number to LC number + TAB + company name, both parsed from the Description. Only_Unapplied keeps rows whose Unapplied amount is above 0." DisplayName="Comment" sap2010:WorkflowViewState.IdRef="Comment_1" />
    <ui:InvokeCode Language="VBNet" Code="Dim text As String = System.IO.File.ReadAllText(path)&#xA;result = New System.Collections.Generic.Dictionary(Of String, System.Collections.Generic.List(Of String))&#xA;lcInfo = New System.Collections.Generic.Dictionary(Of String, String)&#xA;Dim rowOpts As System.Text.RegularExpressions.RegexOptions = System.Text.RegularExpressions.RegexOptions.Singleline Or System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xA;For Each r As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(text, &quot;&lt;tr[^&gt;]*&gt;(.*?)&lt;/tr&gt;&quot;, rowOpts)&#xA;    Dim cells = System.Text.RegularExpressions.Regex.Matches(r.Groups(1).Value, &quot;&lt;t[dh][^&gt;]*&gt;(.*?)&lt;/t[dh]&gt;&quot;, rowOpts)&#xA;    If cells.Count &lt; 19 Then Continue For&#xA;    Dim ou As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(cells(2).Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot;&quot;)).Trim()&#xA;    Dim inv As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(cells(3).Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot;&quot;)).Trim()&#xA;    Dim site As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(cells(6).Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot;&quot;)).Trim()&#xA;    Dim desc As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(cells(10).Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot;&quot;)).Trim()&#xA;    Dim bank As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(cells(5).Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot;&quot;)).Trim()&#xA;    Dim un As String = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(cells(17).Groups(1).Value, &quot;&lt;[^&gt;]+&gt;&quot;, &quot;&quot;)).Trim()&#xA;    If ou = &quot;&quot; OrElse ou = &quot;OU Name&quot; OrElse inv = &quot;&quot; Then Continue For&#xA;    If Not site.Equals(&quot;LC OPENING CHAR&quot;, StringComparison.OrdinalIgnoreCase) Then Continue For&#xA;    If onlyUnapplied Then&#xA;        Dim amt As Double&#xA;        If Not Double.TryParse(un, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, amt) OrElse amt &lt;= 0 Then Continue For&#xA;    End If&#xA;    Dim d As String = System.Text.RegularExpressions.Regex.Replace(desc.Replace(ChrW(160), &quot; &quot;), &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;    Dim lcNo As String = &quot;&quot;&#xA;    Dim company As String = &quot;&quot;&#xA;    Dim m As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(d, &quot;\bLC\s*-\s*(?:(?![Dd][Cc]\s)[A-Za-z]{1,3}\s+)?((?:[Dd][Cc]\s+)?[A-Za-z0-9]*\d[A-Za-z0-9]*)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;    If Not m.Success Then m = System.Text.RegularExpressions.Regex.Match(d, &quot;[-_]\s*(\d{9,})&quot;)&#xA;    If m.Success Then&#xA;        lcNo = m.Groups(1).Value&#xA;        Dim rest As String = d.Substring(m.Index + m.Length).TrimStart(&quot; &quot;c, &quot;_&quot;c)&#xA;        rest = System.Text.RegularExpressions.Regex.Replace(rest, &quot;^[A-Za-z]{2,4}_&quot;, &quot;&quot;)&#xA;        rest = System.Text.RegularExpressions.Regex.Replace(rest, &quot;^Ref\s*-\s*(Need Check\s*)?&quot;, &quot;&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;        If rest.StartsWith(lcNo, StringComparison.OrdinalIgnoreCase) Then rest = rest.Substring(lcNo.Length).TrimStart(&quot; &quot;c, &quot;-&quot;c)&#xA;        rest = System.Text.RegularExpressions.Regex.Replace(rest, &quot;\s+(Foreign|Local)\b.*$&quot;, &quot;&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;        company = rest.Trim(&quot; &quot;c, &quot;,&quot;c, &quot;_&quot;c, &quot;-&quot;c)&#xA;    End If&#xA;    Dim unit As String = ou.Split(&quot; &quot;c)(0)&#xA;    If Not result.ContainsKey(unit) Then result(unit) = New System.Collections.Generic.List(Of String)&#xA;    If Not result(unit).Contains(inv) Then result(unit).Add(inv)&#xA;    lcInfo(inv) = lcNo &amp; vbTab &amp; company &amp; vbTab &amp; bank&#xA;Next" DisplayName="Build unit to invoice dictionary" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="path">[Report_File]</InArgument>
        <InArgument x:TypeArguments="x:Boolean" x:Key="onlyUnapplied">[Only_Unapplied]</InArgument>
