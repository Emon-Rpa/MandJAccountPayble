sign><Assign DisplayName="Statement currency"><Assign.To><OutArgument x:TypeArguments="x:String">[rowCcy]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[in_Row("CURRENCY").ToString]</InArgument></Assign.Value></Assign><Assign DisplayName="Statement amount"><Assign.To><OutArgument x:TypeArguments="x:String">[rowAmount]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[in_Row(&quot;AMOUNT&quot;).ToString]</InArgument></Assign.Value></Assign><Assign DisplayName="Statement description"><Assign.To><OutArgument x:TypeArguments="x:String">[rowDesc]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[in_Row(&quot;Statement_Descriptions&quot;).ToString]</InArgument></Assign.Value></Assign><ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim target As Double = Val(rowAmount.Replace(&quot;,&quot;, &quot;&quot;))&#xA;Dim refNo As String = rowRef.Trim&#xA;Dim pick As String = &quot;&quot;&#xA;Dim score As Integer = 0&#xA;If refNo &lt;&gt; &quot;&quot; Then&#xA;    For Each c As String In allText.Split(New String() {&quot;&lt;&lt;PDF&gt;&gt;&quot;}, StringSplitOptions.RemoveEmptyEntries)&#xA;        If c.Replace(&quot; &quot;, &quot;&quot;).Contains(refNo) Then&#xA;            Dim s As Integer = 1&#xA;            Dim tm As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(c, rules(&quot;Adv_Total_Debited_Regex&quot;))&#xA;            If tm.Success AndAlso Math.Abs(Val(tm.Groups(1).Value.Replace(&quot;,&quot;, &quot;&quot;)) - target) &lt; 0.01 Then&#xA;                s = 2&#xA;            End If&#xA;            If s &gt; score Then&#xA;                score = s&#xA;                pick = c&#xA;            End If&#xA;        End If&#xA;    Next&#xA;End If&#xA;Dim advKey As String = &quot;&quot;&#xA;Dim bene As String = &quot;&quot;&#xA;Dim lcAmt As String = &quot;&quot;&#xA;Dim repLine As String = &quot;&quot;&#xA;Dim totTxt As String = &quot;&quot;&#xA;yourRef = &quot;&quot;&#xA;acctNo = &quot;&quot;&#xA;If pick &lt;&gt; &quot;&quot; Then&#xA;    yourRef = System.Text.RegularExpressions.Regex.Match(pick, rules(&quot;Adv_Your_Ref_Regex&quot;)).Groups(1).Value.Trim&#xA;    acctNo = System.Text.RegularExpressions.Regex.Match(pick, rules(&quot;Adv_Account_Regex&quot;)).Groups(1).Value&#xA;    bene = System.Text.RegularExpressions.Regex.Match(pick, rules(&quot;Adv_Beneficiary_Regex&quot;)).Groups(1).Value.Trim&#xA;    lcAmt = System.Text.RegularExpressions.Regex.Match(pick, rules(&quot;Adv_Amount_Regex&quot;)).Groups(1).Value&#xA;    repLine = System.Text.RegularExpressions.Regex.Match(pick, rules(&quot;Adv_Representing_Regex&quot;)).Groups(1).Value.Trim&#xA;    totTxt = System.Text.RegularExpressions.Regex.Match(pick, rules(&quot;Adv_Total_Debited_Text_Regex&quot;)).Groups(1).Value&#xA;    Dim up As String = repLine.ToUpper&#xA;    For Each lm As String In rules(&quot;Adv_Line_Map&quot;).Split(&quot;|&quot;c)&#xA;        Dim lp() As String = lm.Split(New String() {&quot;=&gt;&quot;}, StringSplitOptions.None)&#xA;        If lp.Length = 2 AndAlso up.StartsWith(lp(0).Trim.ToUpper) Then&#xA;            advKey = lp(1).Trim&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;End If&#xA;cLc = &quot;&quot;&#xA;cPrin = &quot;&quot;&#xA;cIntr = &quot;&quot;&#xA;cExc = &quot;&quot;&#xA;cBillCcy = &quot;&quot;&#xA;cBillAmt = &quot;&quot;&#xA;If pick &lt;&gt; &quot;&quot; AndAlso score = 2 Then&#xA;    If rules.ContainsKey(&quot;Adv_LC_Regex&quot;) Then cLc = System.Text.RegularExpressions.Regex.Match(pick, rules(&quot;Adv_LC_Regex&quot;)).Groups(1).Value.Trim&#xA;    Dim blk As String = pick&#xA;    Dim ri As Integer = blk.IndexOf(rules(&quot;Adv_Block_Start&quot;))&#xA;    Dim ti As Integer = blk.IndexOf(rules(&quot;Adv_Block_End&quot;))&#xA;    If ri &gt;= 0 AndAlso ti &gt; ri Then blk = blk.Substring(ri, ti - ri)&#xA;    Dim inlineRx As String = rules(&quot;Adv_Inline_Amount_Regex&quot;)&#xA;    Dim aloneRx As String = rules(&quot;Adv_Alone_Amount_Regex&quot;)&#xA;    Dim wanted As New List(Of String)&#xA;    Dim found As New Dictionary(Of String, String)&#xA;    Dim alone As New List(Of String)&#xA;    For Each ln As String In blk.Split(New Char() {ChrW(10), ChrW(13)}, StringSplitOptions.RemoveEmptyEntries)&#xA;        Dim u As String = ln.Trim.ToUpper&#xA;        Dim lbl As String = &quot;&quot;&#xA;        If u.StartsWith(rules(&quot;Adv_Principal_Label&quot;).ToUpper) Then&#xA;            lbl = &quot;P&quot;&#xA;        ElseIf u.StartsWith(rules(&quot;Adv_Interest_Label&quot;).ToUpper) Then&#xA;            lbl = &quot;I&quot;&#xA;        ElseIf u.StartsWith(rules(&quot;Adv_Excise_Label&quot;).ToUpper) Then&#xA;            lbl = &quot;E&quot;&#xA;        End If&#xA;        Dim am As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(u, inlineRx)&#xA;        If lbl &lt;&gt; &quot;&quot; Then&#xA;            If am.Success Then&#xA;                found(lbl) = am.Groups(1).Value.Replace(&quot;,&quot;, &quot;&quot;)&#xA;            Else&#xA;                wanted.Add(lbl)&#xA;            End If&#xA;        ElseIf System.Text.RegularExpressions.Regex.IsMatch(u, aloneRx) Then&#xA;            alone.Add(am.Groups(1).Value.Replace(&quot;,&quot;, &quot;&quot;))&#xA;        End If&#xA;    Next&#xA;    For wi As Integer = 0 To Math.Min(wanted.Count, alone.Count) - 1&#xA;        found(wanted(wi)) = alone(wi)&#xA;    Next&#xA;    If found.ContainsKey(&quot;P&quot;) Then cPrin = found(&quot;P&quot;)&#xA;    If found.ContainsKey(&quot;I&quot;) Then cIntr = found(&quot;I&quot;)&#xA;    If found.ContainsKey(&quot;E&quot;) Then cExc = found(&quot;E&quot;)&#xA;    Dim bm As String = lcAmt.Trim&#xA;    If bm.Length &gt; 3 Then&#xA;        cBillCcy = bm.Substring(0, 3).ToUpper&#xA;        cBillAmt = bm.Substring(3).Trim.Replace(&quot;,&quot;, &quot;&quot;)&#xA;    End If&#xA;End If&#xA;Dim mapSkip As Boolean = False&#xA;eventKey = &quot;&quot;&#xA;mapSite = &quot;&quot;&#xA;mapType = &quot;&quot;&#xA;mapAccount = &quot;&quot;&#xA;mapRoute = &quot;&quot;&#xA;If score = 2 AndAlso advKey &lt;&gt; &quot;&quot; Then&#xA;    eventKey = advKey&#xA;End If&#xA;If eventKey = &quot;&quot; Then&#xA;    Dim desc As String = rowDesc.ToUpper&#xA;    Dim bestLen As Integer = 0&#xA;    For Each mr As System.Data.DataRow In map.Rows&#xA;        Dim cands As New List(Of String)&#xA;        cands.Add(mr(0).ToString.Trim.ToUpper)&#xA;        If map.Columns.Count &gt; 6 Then&#xA;            For Each a As String In mr(6).ToString.ToUpper.Split(&quot;|&quot;c)&#xA;                If a.Trim &lt;&gt; &quot;&quot; Then cands.Add(a.Trim)&#xA;            Next&#xA;        End If&#xA;        For Each k As String In cands&#xA;            If k &lt;&gt; &quot;&quot; AndAlso desc.Contains(k) AndAlso k.Length &gt; bestLen Then&#xA;                bestLen = k.Length&#xA;                eventKey = mr(0).ToString.Trim&#xA;            End If&#xA;        Next&#xA;    Next&#xA;End If&#xA;If eventKey &lt;&gt; &quot;&quot; Then&#xA;    For Each mr As System.Data.DataRow In map.Rows&#xA;        If mr(0).ToString.Trim.ToUpper = eventKey.ToUpper Then&#xA;            mapSite = mr(1).ToString&#xA;            mapType = mr(2).ToString&#xA;            mapAccount = mr(3).ToString&#xA;            If map.Columns.Count &gt; 7 AndAlso mr(7).ToString.ToUpper.Contains(rules(&quot;Skip_Marker&quot;).ToUpper) Then mapSkip = True&#xA;            If map.Columns.Count &gt; 8 AndAlso mr(8).ToString.Trim &lt;&gt; &quot;&quot; Then&#xA;                For Each tk As String In mr(8).ToString.Trim.Split(&quot;|&quot;c)&#xA;                    Dim pr() As String = tk.Trim.Split(&quot;@&quot;c)&#xA;                    If pr.Length = 1 OrElse pr(1).Trim.ToUpper = rowCcy.Trim.ToUpper Then&#xA;                        mapRoute = pr(0).Trim.ToUpper&#xA;                        Exit For&#xA;                    End If&#xA;                Next&#xA;            End If&#xA;            Exit For&#xA;        End If&#xA; 